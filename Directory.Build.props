<Project>

  <!-- Shared settings for every project in the Reshot solution. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Company>Reshot</Company>
    <Product>Reshot</Product>
    <Authors>reteren</Authors>
    <Copyright>Copyright (c) 2026 Reshot contributors</Copyright>
    <RepositoryUrl>https://github.com/reteren/reshot</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
