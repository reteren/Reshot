<Window x:Class="Reshot.App.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Roboto, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        ToolTipService.InitialShowDelay="1000"
        ToolTipService.ShowDuration="8000"
        Focusable="True">
    <!--
        HUD chrome follows the same Half-Life 2 / Source VGUI vocabulary as the
        settings app (src/reshot-tauri/src/styles.css): translucent grey panels,
        raised bevels drawn as two nested Borders (WPF cannot colour border sides
        individually), and #3C9898 as the single accent.
    -->
    <Window.Resources>
        <SolidColorBrush x:Key="PanelTint" Color="#D9767676" />
        <SolidColorBrush x:Key="BtnBg" Color="#7B7B7B" />
        <SolidColorBrush x:Key="BevelLight" Color="#BBBBBB" />
        <SolidColorBrush x:Key="BevelDark" Color="#454545" />
        <SolidColorBrush x:Key="Accent" Color="#3C9898" />
        <SolidColorBrush x:Key="AccentDim" Color="#803C9898" />
        <SolidColorBrush x:Key="Ink" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="InputBg" Color="#5A5A5A" />
        <SolidColorBrush x:Key="InputDark" Color="#343434" />
        <SolidColorBrush x:Key="InputLight" Color="#B7B7B7" />
        <SolidColorBrush x:Key="RuleDark" Color="#434343" />
        <SolidColorBrush x:Key="RuleLight" Color="#BBBABA" />

        <!--
            Icon-only tool button. Flat until touched: hover fills with the accent,
            the active tool keeps a dimmed accent fill plus an inverted bevel so it
            reads as pressed, exactly like a VGUI toggle.
        -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <!-- Never take keyboard focus: a focused button would eat Space/Enter as a
                 click, stealing them from the text caret. Mouse clicks still work. -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outer"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1,1,0,0"
                                BorderBrush="Transparent">
                            <Border x:Name="Inner" BorderThickness="0,0,1,1" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource BevelLight}" />
                                <Setter TargetName="Inner" Property="BorderBrush" Value="{StaticResource BevelDark}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource BevelDark}" />
                                <Setter TargetName="Inner" Property="BorderBrush" Value="{StaticResource BevelLight}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Outer" Property="Background" Value="{StaticResource AccentDim}" />
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource BevelDark}" />
                                <Setter TargetName="Inner" Property="BorderBrush" Value="{StaticResource BevelLight}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Raised HL2 push button, used for the settings panel's Reset. -->
        <Style x:Key="HlButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Cursor" Value="Arrow" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outer" Background="{StaticResource BtnBg}"
                                BorderThickness="1,1,0,0" BorderBrush="{StaticResource BevelLight}">
                            <Border x:Name="Inner" BorderThickness="0,0,1,1" BorderBrush="{StaticResource BevelDark}">
                                <ContentPresenter Margin="8,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource BevelDark}" />
                                <Setter TargetName="Inner" Property="BorderBrush" Value="{StaticResource BevelLight}" />
                            </Trigger>
                            <!-- Latched (e.g. the eyedropper waiting for a right-click). -->
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Outer" Property="Background" Value="{StaticResource AccentDim}" />
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource BevelDark}" />
                                <Setter TargetName="Inner" Property="BorderBrush" Value="{StaticResource BevelLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Raised HL2 button sized for an icon: same bevel as HlButton, but the content is
            centred with no horizontal padding (HlButton's 8px margins squeeze a glyph
            off-centre once the button is only ~26px wide).
        -->
        <Style x:Key="HlIconButton" TargetType="Button" BasedOn="{StaticResource HlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Outer" Background="{StaticResource BtnBg}"
                                BorderThickness="1,1,0,0" BorderBrush="{StaticResource BevelLight}">
                            <Border x:Name="Inner" BorderThickness="0,0,1,1" BorderBrush="{StaticResource BevelDark}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource BevelDark}" />
                                <Setter TargetName="Inner" Property="BorderBrush" Value="{StaticResource BevelLight}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="on">
                                <Setter TargetName="Outer" Property="Background" Value="{StaticResource AccentDim}" />
                                <Setter TargetName="Outer" Property="BorderBrush" Value="{StaticResource BevelDark}" />
                                <Setter TargetName="Inner" Property="BorderBrush" Value="{StaticResource BevelLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==== Source/VGUI context menu (audio + video source pickers) ==== -->

        <Style x:Key="HlSeparator" TargetType="Separator">
            <Setter Property="Margin" Value="6,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <StackPanel>
                            <Border Height="1" Background="{StaticResource RuleDark}" />
                            <Border Height="1" Background="{StaticResource RuleLight}" />
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rows highlight teal (where HL2 used orange); checkable rows get an inset box. -->
        <Style x:Key="HlMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" Background="Transparent" Padding="7,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Inset checkbox well, only for checkable rows. -->
                                <Border x:Name="CheckBox" Width="12" Height="12"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Visibility="Collapsed"
                                        Background="{StaticResource InputBg}"
                                        BorderThickness="1,1,0,0" BorderBrush="{StaticResource InputDark}">
                                    <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource InputLight}">
                                        <Path x:Name="Tick" Visibility="Collapsed"
                                              Stroke="{StaticResource Ink}" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Data="M1.5,5 L4,7.5 L8.5,2" />
                                    </Border>
                                </Border>

                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsCheckable" Value="True">
                                <Setter TargetName="CheckBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HlContextMenu" TargetType="ContextMenu">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{StaticResource PanelTint}"
                                CornerRadius="6" Padding="4"
                                BorderThickness="1" BorderBrush="{StaticResource BevelDark}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                <StackPanel IsItemsHost="True" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Inset HL2 slider: sunken track, raised thumb. -->
        <Style x:Key="HlSlider" TargetType="Slider">
            <!-- Click-to-position + immediate drag is done fully in code (EnableSliderClickDrag),
                 not via IsMoveToPointEnabled, so the thumb never keeps a pre-jump drag origin. -->
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6" VerticalAlignment="Center"
                                    Background="{StaticResource InputBg}"
                                    BorderThickness="1,1,0,0" BorderBrush="{StaticResource InputDark}">
                                <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource InputLight}" />
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="10" Height="18"
                                                        Background="{StaticResource BtnBg}"
                                                        BorderThickness="1,1,0,0" BorderBrush="{StaticResource BevelLight}">
                                                    <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource BevelDark}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Tooltips in the same VGUI dress as the rest of the HUD. Windows' default
            chrome (and its 3s delay) would be the only foreign surface on screen.
        -->
        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource PanelTint}"
                                BorderThickness="1,1,0,0" BorderBrush="{StaticResource BevelLight}">
                            <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource BevelDark}">
                                <ContentPresenter Margin="6,3" />
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- The frozen desktop frame, shown 1:1 (stretched to fill the DIP client). -->
        <Image x:Name="FrameView"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality" />

        <!-- Dim overlay: filled everywhere except the selection (even-odd hole). -->
        <Path x:Name="DimPath" IsHitTestVisible="False" />

        <!-- Editor canvas (brush strokes, shapes, text) + brush-size cursor. -->
        <skia:SKElement x:Name="DrawSurface" IsHitTestVisible="False" />

        <!-- Selection chrome: shape outline (arbitrary geometry) + resize handles. -->
        <Canvas x:Name="ChromeLayer" IsHitTestVisible="False">
            <Path x:Name="SelectionOutline"
                  Visibility="Collapsed"
                  Stroke="#FF3C9898"
                  StrokeThickness="1.5" />
            <Path x:Name="PolygonPreview"
                  Visibility="Collapsed"
                  Stroke="#FF3C9898"
                  StrokeThickness="1.5"
                  StrokeDashArray="4 3" />

            <!-- Exported size in physical pixels, pinned to the selection's top-left. -->
            <Border x:Name="SizeBadge"
                    Visibility="Collapsed"
                    Background="{StaticResource PanelTint}"
                    CornerRadius="3"
                    Padding="6,2">
                <TextBlock x:Name="SizeBadgeText"
                           Style="{StaticResource PanelLabel}"
                           Text="0 × 0" />
            </Border>
        </Canvas>

        <!-- Toolbar layer (hit-testable), positioned near the selection. -->
        <Canvas x:Name="ToolbarLayer">

            <!-- ==== Tool settings panel (strip click, or Shift) ==== -->
            <Border x:Name="BrushPanel"
                    Visibility="Collapsed"
                    Width="272"
                    ClipToBounds="True"
                    Background="{StaticResource PanelTint}"
                    CornerRadius="8"
                    Padding="10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="Size" Style="{StaticResource PanelLabel}" Width="88" DockPanel.Dock="Left" />
                        <TextBlock x:Name="ThicknessValue" Text="5 px" Style="{StaticResource PanelLabel}"
                                   Width="40" DockPanel.Dock="Right" TextAlignment="Right" />
                        <Slider x:Name="ThicknessSlider" Style="{StaticResource HlSlider}" Minimum="1" Maximum="200" Value="5" />
                    </DockPanel>

                    <DockPanel x:Name="StrengthRow" Margin="0,0,0,8">
                        <TextBlock x:Name="StrengthLabel" Text="Opacity" Style="{StaticResource PanelLabel}"
                                   Width="88" DockPanel.Dock="Left" />
                        <TextBlock x:Name="OpacityValue" Text="100%" Style="{StaticResource PanelLabel}"
                                   Width="40" DockPanel.Dock="Right" TextAlignment="Right" />
                        <Slider x:Name="OpacitySlider" Style="{StaticResource HlSlider}" Minimum="0" Maximum="100" Value="100" />
                    </DockPanel>

                    <!-- Eraser-only: Photoshop hardness. Centre always erases 100%; lower
                         values fade the erase toward the rim (a soft gradient). -->
                    <DockPanel x:Name="HardnessRow" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock Text="Opacity" Style="{StaticResource PanelLabel}"
                                   Width="88" DockPanel.Dock="Left" />
                        <TextBlock x:Name="HardnessValue" Text="100%" Style="{StaticResource PanelLabel}"
                                   Width="40" DockPanel.Dock="Right" TextAlignment="Right" />
                        <Slider x:Name="HardnessSlider" Style="{StaticResource HlSlider}" Minimum="0" Maximum="100" Value="100" />
                    </DockPanel>

                    <!-- Colour section: hidden for erasers and effects, which have no colour. -->
                    <StackPanel x:Name="ColorSection">
                        <Border Height="1" Background="{StaticResource RuleDark}" Margin="0,2,0,0" />
                        <Border Height="1" Background="{StaticResource RuleLight}" Margin="0,0,0,8" />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border BorderThickness="1,1,0,0" BorderBrush="{StaticResource InputDark}">
                                <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource InputLight}">
                                    <Canvas x:Name="SvSquare" Width="204" Height="120" ClipToBounds="True">
                                        <Rectangle x:Name="SvHueFill" Width="204" Height="120" />
                                        <Rectangle Width="204" Height="120">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Offset="0" Color="#FFFFFFFF" />
                                                    <GradientStop Offset="1" Color="#00FFFFFF" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Rectangle Width="204" Height="120">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0" Color="#00000000" />
                                                    <GradientStop Offset="1" Color="#FF000000" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Ellipse x:Name="SvThumb" Width="11" Height="11" Stroke="White" StrokeThickness="2"
                                                 IsHitTestVisible="False" />
                                    </Canvas>
                                </Border>
                            </Border>

                            <Border BorderThickness="1,1,0,0" BorderBrush="{StaticResource InputDark}" Margin="8,0,0,0">
                                <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource InputLight}">
                                    <Canvas x:Name="HueBar" Width="16" Height="120" ClipToBounds="True">
                                        <Rectangle Width="16" Height="120">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Offset="0.00" Color="#FFFF0000" />
                                                    <GradientStop Offset="0.17" Color="#FFFFFF00" />
                                                    <GradientStop Offset="0.33" Color="#FF00FF00" />
                                                    <GradientStop Offset="0.50" Color="#FF00FFFF" />
                                                    <GradientStop Offset="0.67" Color="#FF0000FF" />
                                                    <GradientStop Offset="0.83" Color="#FFFF00FF" />
                                                    <GradientStop Offset="1.00" Color="#FFFF0000" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Border x:Name="HueThumb" Width="18" Height="4" Canvas.Left="-1"
                                                Background="#00000000" BorderBrush="White" BorderThickness="2"
                                                IsHitTestVisible="False" />
                                    </Canvas>
                                </Border>
                            </Border>
                        </StackPanel>

                        <DockPanel Margin="0,0,0,8">
                            <Border x:Name="ColorPreview" Width="22" Height="22"
                                    DockPanel.Dock="Left" Background="#FFFF3B30"
                                    BorderThickness="1,1,0,0" BorderBrush="{StaticResource InputDark}" Margin="0,0,6,0">
                                <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource InputLight}" />
                            </Border>

                            <!-- Eyedropper: arms the picker so it stays live until a right-click. -->
                            <Button x:Name="EyedropperButton" DockPanel.Dock="Left"
                                    Style="{StaticResource HlIconButton}" Width="26" Height="22"
                                    ToolTip="Color picker. Right-click and hold on the image to pick a colour. Click here to keep it armed until you right-click.">
                                <!-- Eyedropper: squeeze bulb top-right, collar, tapered tube down
                                     to a tip bottom-left. A 14x14 box divides evenly into the
                                     button's 24x20 content area, so the padding is exact. -->
                                <Viewbox Width="14" Height="14">
                                    <Canvas Width="15" Height="15">
                                        <Path Fill="{StaticResource Ink}"
                                              Data="M9.9,0.9 a2.7,2.7 0 0 1 3.8,3.8 L12.6,5.8 L8.8,2.0 Z" />
                                        <Path Fill="{StaticResource Ink}"
                                              Data="M8.0,2.8 L11.8,6.6 L10.7,7.7 L6.9,3.9 Z" />
                                        <Path Fill="{StaticResource Ink}"
                                              Data="M6.3,4.9 L9.7,8.3 L3.6,14.1 L0.9,14.6 L1.4,11.9 Z" />
                                    </Canvas>
                                </Viewbox>
                            </Button>

                            <Button x:Name="ResetColorButton" Content="Reset" DockPanel.Dock="Right"
                                    Style="{StaticResource HlButton}" Margin="6,0,0,0" />
                            <Border HorizontalAlignment="Right" Width="84" Margin="6,0,0,0"
                                    BorderThickness="1,1,0,0" BorderBrush="{StaticResource InputDark}">
                                <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource InputLight}">
                                    <TextBox x:Name="HexInput" Text="#FF3B30" VerticalContentAlignment="Center"
                                             Height="22" Background="{StaticResource InputBg}" Foreground="White"
                                             BorderThickness="0" CaretBrush="White" FontSize="11" Padding="4,0" />
                                </Border>
                            </Border>
                        </DockPanel>

                        <UniformGrid x:Name="SwatchGrid" Columns="8" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==== Sub-tool flyouts (right-click a tab) ==== -->

            <Border x:Name="SelectFlyout" Visibility="Collapsed"
                    Background="{StaticResource PanelTint}" CornerRadius="6" Padding="3">
                <StackPanel Orientation="Vertical">
                    <!-- Rectangle: dashed outline. -->
                    <Button x:Name="ShapeRectBtn" Style="{StaticResource IconButton}" ToolTip="Rectangle">
                        <Rectangle Width="17" Height="14" Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeDashArray="3 2" />
                    </Button>
                    <!-- Ellipse: dashed outline. -->
                    <Button x:Name="ShapeEllipseBtn" Style="{StaticResource IconButton}" ToolTip="Ellipse">
                        <Ellipse Width="17" Height="15" Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeDashArray="3 2" />
                    </Button>
                    <!-- Triangle: dashed outline. -->
                    <Button x:Name="ShapeTriangleBtn" Style="{StaticResource IconButton}" ToolTip="Triangle">
                        <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeDashArray="3 2" StrokeLineJoin="Round"
                              Data="M9,2 L17,16 L1,16 Z" />
                    </Button>
                <!-- Lasso: rope loop with a tail. -->
                    <Button x:Name="ShapeLassoBtn" Style="{StaticResource IconButton}" ToolTip="Lasso">
                        <Canvas Width="20" Height="20">
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6"
                                  Data="M10,3 C15,3 19,5.7 19,9 C19,12.3 15,15 10,15 C5,15 1,12.3 1,9 C1,5.7 5,3 10,3 Z" />
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  Data="M5,14 C4,16 5,18 7,18.5" />
                        </Canvas>
                    </Button>
                    <!-- Polygon: three segments hinged on three vertices, like a graph. -->
                    <Button x:Name="ShapePolygonBtn" Style="{StaticResource IconButton}" ToolTip="Polygon">
                        <Canvas Width="20" Height="20">
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M2,16 L7,6 L13,13 L19,3" />
                            <Ellipse Canvas.Left="0" Canvas.Top="14" Width="4" Height="4" Fill="{StaticResource Ink}" />
                            <Ellipse Canvas.Left="5" Canvas.Top="4" Width="4" Height="4" Fill="{StaticResource Ink}" />
                            <Ellipse Canvas.Left="11" Canvas.Top="11" Width="4" Height="4" Fill="{StaticResource Ink}" />
                        </Canvas>
                    </Button>
                    </StackPanel>
            </Border>

            <Border x:Name="ShapesFlyout" Visibility="Collapsed"
                    Background="{StaticResource PanelTint}" CornerRadius="6" Padding="3">
                <StackPanel Orientation="Vertical">
                    <Button x:Name="ToolSquareBtn" Style="{StaticResource IconButton}" ToolTip="Square">
                        <Rectangle Width="15" Height="15" Stroke="{StaticResource Ink}" StrokeThickness="1.8" />
                    </Button>
                    <Button x:Name="ToolCircleBtn" Style="{StaticResource IconButton}" ToolTip="Circle">
                        <Ellipse Width="15" Height="15" Stroke="{StaticResource Ink}" StrokeThickness="1.8" />
                    </Button>
                    <Button x:Name="ToolTriangleBtn" Style="{StaticResource IconButton}" ToolTip="Triangle">
                        <Path Stroke="{StaticResource Ink}" StrokeThickness="1.8" StrokeLineJoin="Round"
                              Data="M9,2 L17,16 L1,16 Z" />
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="LinesFlyout" Visibility="Collapsed"
                    Background="{StaticResource PanelTint}" CornerRadius="6" Padding="3">
                <StackPanel Orientation="Vertical">
                    <Button x:Name="ToolArrowBtn" Style="{StaticResource IconButton}" ToolTip="Arrow">
                        <Path Stroke="{StaticResource Ink}" StrokeThickness="1.8" StrokeLineJoin="Round"
                              Data="M1,17 L17,1 M17,1 L9,2 M17,1 L16,9" />
                    </Button>
                    <Button x:Name="ToolLineBtn" Style="{StaticResource IconButton}" ToolTip="Line">
                        <Line X1="1" Y1="17" X2="17" Y2="1" Stroke="{StaticResource Ink}" StrokeThickness="1.8" />
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="EraserFlyout" Visibility="Collapsed"
                    Background="{StaticResource PanelTint}" CornerRadius="6" Padding="3">
                <StackPanel Orientation="Vertical">
                    <!-- Plain eraser. -->
                    <Button x:Name="ToolEraserBtn" Style="{StaticResource IconButton}" ToolTip="Eraser">
                        <Canvas Width="20" Height="20">
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M6,17 L1.5,12.5 L11,3 L17.5,9.5 L10,17 Z" />
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" Data="M6.2,7.8 L12.8,14.4" />
                        </Canvas>
                    </Button>
                    <!-- Filter eraser: a droplet marks that it removes effects. -->
                    <Button x:Name="ToolFilterEraserBtn" Style="{StaticResource IconButton}" ToolTip="Filter eraser (removes blur / pixelation)">
                        <Canvas Width="22" Height="20">
                            <Path Fill="{StaticResource Ink}" Data="M4,4 C4,4 1,8 1,10 A3,3 0 0 0 7,10 C7,8 4,4 4,4 Z" />
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M12,17 L8.5,13.5 L15,7 L20.5,12.5 L16,17 Z" />
                        </Canvas>
                    </Button>
                    <!-- Absolute eraser: an infinity mark, it erases all the way to transparency. -->
                    <Button x:Name="ToolAbsEraserBtn" Style="{StaticResource IconButton}" ToolTip="Absolute eraser (to transparency)">
                        <Canvas Width="22" Height="20">
                            <Ellipse Canvas.Left="0" Canvas.Top="7" Width="6" Height="6"
                                     Stroke="{StaticResource Ink}" StrokeThickness="1.5" />
                            <Ellipse Canvas.Left="4.5" Canvas.Top="7" Width="6" Height="6"
                                     Stroke="{StaticResource Ink}" StrokeThickness="1.5" />
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M13,17 L10,14 L15.5,8.5 L20.5,13.5 L16.5,17 Z" />
                        </Canvas>
                    </Button>
                </StackPanel>
            </Border>

            <Border x:Name="EffectsFlyout" Visibility="Collapsed"
                    Background="{StaticResource PanelTint}" CornerRadius="6" Padding="3">
                <StackPanel Orientation="Vertical">
                    <!-- Pixelate: a 3x3 block ramp, bright top-left to dark bottom-right. -->
                    <Button x:Name="ToolPixelizeBtn" Style="{StaticResource IconButton}" ToolTip="Pixelate">
                        <UniformGrid Columns="3" Rows="3" Width="18" Height="18">
                            <Rectangle Fill="#FFFFFFFF" Margin="0.5" />
                            <Rectangle Fill="#D9FFFFFF" Margin="0.5" />
                            <Rectangle Fill="#A6FFFFFF" Margin="0.5" />
                            <Rectangle Fill="#D9FFFFFF" Margin="0.5" />
                            <Rectangle Fill="#A6FFFFFF" Margin="0.5" />
                            <Rectangle Fill="#73FFFFFF" Margin="0.5" />
                            <Rectangle Fill="#A6FFFFFF" Margin="0.5" />
                            <Rectangle Fill="#73FFFFFF" Margin="0.5" />
                            <Rectangle Fill="#40FFFFFF" Margin="0.5" />
                        </UniformGrid>
                    </Button>
                    <!-- Blur: a smooth ramp across the same square. -->
                    <Button x:Name="ToolBlurBtn" Style="{StaticResource IconButton}" ToolTip="Blur">
                        <Rectangle Width="18" Height="18">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#FFFFFFFF" />
                                    <GradientStop Offset="1" Color="#14FFFFFF" />
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Eyedropper preview (RMB-hold while drawing). -->
            <Border x:Name="EyedropperPreview"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    Background="{StaticResource PanelTint}"
                    CornerRadius="6"
                    Padding="5">
                <StackPanel Orientation="Horizontal">
                    <Border x:Name="EyedropperSwatch" Width="28" Height="28"
                            BorderThickness="1,1,0,0" BorderBrush="{StaticResource InputDark}">
                        <Border BorderThickness="0,0,1,1" BorderBrush="{StaticResource InputLight}" />
                    </Border>
                    <TextBlock x:Name="EyedropperHex" Style="{StaticResource PanelLabel}"
                               Margin="8,0,4,0" Text="#000000" />
                </StackPanel>
            </Border>

            <!--
                Settings strip: a thin handle above the toolbar, shown only for tools
                that have adjustable settings. Clicking it opens the panel (so does Shift).
            -->
            <Border x:Name="SettingsStrip"
                    Visibility="Collapsed"
                    Height="14"
                    Cursor="Arrow"
                    CornerRadius="6"
                    Background="{StaticResource PanelTint}"
                    ToolTip="Tool settings">
                <Grid>
                    <!-- Brightens under the pointer, like every other HUD control. -->
                    <Border x:Name="StripHover" CornerRadius="6" Background="{StaticResource Accent}" Opacity="0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="3" Height="3" Fill="#DDFFFFFF" Margin="2,0" />
                        <Ellipse Width="3" Height="3" Fill="#DDFFFFFF" Margin="2,0" />
                        <Ellipse Width="3" Height="3" Fill="#DDFFFFFF" Margin="2,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==== Main tool strip ==== -->
            <Border x:Name="Toolbar"
                    Visibility="Collapsed"
                    Background="{StaticResource PanelTint}"
                    CornerRadius="8"
                    Padding="4">
                <StackPanel Orientation="Horizontal">
                    <!-- 1. Selection -->
                    <Button x:Name="SelectTab" Style="{StaticResource IconButton}" ToolTip="Selection (1)">
                        <Rectangle Width="17" Height="14" Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeDashArray="3 2" />
                    </Button>
                    <!-- 2. Draw -->
                    <Button x:Name="ToolBrushBtn" Style="{StaticResource IconButton}"
                            ToolTip="Brush (2). Right click for color picker">
                        <Canvas Width="20" Height="20">
                            <Path Fill="{StaticResource Ink}" Data="M18.6,1.4 a2,2 0 0 1 0,2.8 L13.2,9.6 L10.4,6.8 L15.8,1.4 a2,2 0 0 1 2.8,0 Z" />
                            <Path Fill="{StaticResource Ink}" Data="M9.4,7.8 L12.2,10.6 L7.4,15.4 a3.5,3.5 0 0 1 -4.6,0.3 C4,14.4 4.4,13 4.6,12.6 Z" />
                        </Canvas>
                    </Button>
                    <!-- 3. Shapes -->
                    <Button x:Name="ShapesTab" Style="{StaticResource IconButton}" ToolTip="Shapes (3)">
                        <Rectangle Width="15" Height="15" Stroke="{StaticResource Ink}" StrokeThickness="1.8" />
                    </Button>
                    <!-- 4. Lines -->
                    <Button x:Name="LinesTab" Style="{StaticResource IconButton}" ToolTip="Lines (4)">
                        <Path Stroke="{StaticResource Ink}" StrokeThickness="1.8" StrokeLineJoin="Round"
                              Data="M1,17 L17,1 M17,1 L9,2 M17,1 L16,9" />
                    </Button>
                    <!-- 5. Eraser -->
                    <Button x:Name="EraserTab" Style="{StaticResource IconButton}" ToolTip="Eraser (5)">
                        <Canvas Width="20" Height="20">
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M6,17 L1.5,12.5 L11,3 L17.5,9.5 L10,17 Z" />
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" Data="M6.2,7.8 L12.8,14.4" />
                        </Canvas>
                    </Button>
                    <!-- 6. Effects -->
                    <Button x:Name="EffectsTab" Style="{StaticResource IconButton}" ToolTip="Effects (6)">
                        <UniformGrid Columns="3" Rows="3" Width="18" Height="18">
                            <Rectangle Fill="#FFFFFFFF" Margin="0.5" />
                            <Rectangle Fill="#D9FFFFFF" Margin="0.5" />
                            <Rectangle Fill="#A6FFFFFF" Margin="0.5" />
                            <Rectangle Fill="#D9FFFFFF" Margin="0.5" />
                            <Rectangle Fill="#A6FFFFFF" Margin="0.5" />
                            <Rectangle Fill="#73FFFFFF" Margin="0.5" />
                            <Rectangle Fill="#A6FFFFFF" Margin="0.5" />
                            <Rectangle Fill="#73FFFFFF" Margin="0.5" />
                            <Rectangle Fill="#40FFFFFF" Margin="0.5" />
                        </UniformGrid>
                    </Button>
                    <!-- 7. OCR: a sheet of text lines. Recognises + selects text in the selection. -->
                    <Button x:Name="OcrTab" Style="{StaticResource IconButton}"
                            ToolTip="Copy text from image, OCR (7). Right-click: AUTO / RU / EN">
                        <Canvas Width="18" Height="20">
                            <Rectangle Canvas.Left="2" Canvas.Top="1" Width="14" Height="18" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="{StaticResource Ink}" StrokeThickness="1.6" />
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.4"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M5,6 L13,6 M5,9.5 L13,9.5 M5,13 L13,13 M5,16.5 L10,16.5" />
                        </Canvas>
                    </Button>
                    <!-- 8. Text -->
                    <Button x:Name="ToolTextBtn" Style="{StaticResource IconButton}" ToolTip="Text (8)">
                        <TextBlock Text="T" FontWeight="Bold" FontSize="17" Foreground="{StaticResource Ink}"
                                   Margin="0,-2,0,0" />
                    </Button>
                    <!-- 8. Record video: a monitor with a record dot in its top-left corner. -->
                    <Button x:Name="RecordTool" Style="{StaticResource IconButton}"
                            ToolTip="Record video (9). Right-click for audio sources">
                        <Canvas Width="20" Height="19">
                            <Rectangle Canvas.Left="1" Canvas.Top="1" Width="18" Height="13" RadiusX="1.5" RadiusY="1.5"
                                       Stroke="{StaticResource Ink}" StrokeThickness="1.6" />
                            <Ellipse Canvas.Left="3.6" Canvas.Top="3.6" Width="4.2" Height="4.2" Fill="{StaticResource Ink}" />
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  Data="M10,14 L10,17 M5.5,17.5 L14.5,17.5" />
                        </Canvas>
                    </Button>
                    <!-- 9. Record audio -->
                    <Button x:Name="AudioTool" Style="{StaticResource IconButton}" ToolTip="Record audio (0). Right-click for sources">
                        <Canvas Width="18" Height="20">
                            <Rectangle Canvas.Left="5.5" Canvas.Top="1" Width="7" Height="11" RadiusX="3.5" RadiusY="3.5"
                                       Stroke="{StaticResource Ink}" StrokeThickness="1.6" />
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeStartLineCap="Round"
                                  Data="M2.5,10 A6.5,6.5 0 0 0 15.5,10" />
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" Data="M9,16.5 L9,19" />
                        </Canvas>
                    </Button>

                    <Border Width="1" Margin="4,3" Background="{StaticResource RuleDark}" />
                    <Border Width="1" Margin="0,3,4,3" Background="{StaticResource RuleLight}" />

                    <Button x:Name="CopyButton" Style="{StaticResource IconButton}" ToolTip="Copy to clipboard">
                        <Canvas Width="19" Height="19">
                            <Rectangle Canvas.Left="0" Canvas.Top="0" Width="12" Height="13"
                                       Stroke="{StaticResource Ink}" StrokeThickness="1.6" />
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M4.5,16.5 L17.5,16.5 L17.5,3.5 L15,3.5" />
                        </Canvas>
                    </Button>
                    <Button x:Name="SaveButton" Style="{StaticResource IconButton}" ToolTip="Save">
                        <Canvas Width="19" Height="19">
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M1,1 L14,1 L18,5 L18,18 L1,18 Z" />
                            <Rectangle Canvas.Left="5" Canvas.Top="1" Width="8" Height="6"
                                       Stroke="{StaticResource Ink}" StrokeThickness="1.4" />
                            <Rectangle Canvas.Left="4" Canvas.Top="11" Width="11" Height="7"
                                       Stroke="{StaticResource Ink}" StrokeThickness="1.4" />
                        </Canvas>
                    </Button>
                    <Button x:Name="SaveAsButton" Style="{StaticResource IconButton}" ToolTip="Save as…">
                        <Canvas Width="21" Height="19">
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6" StrokeLineJoin="Round"
                                  Data="M1,1 L12,1 L16,5 L16,13 L1,13 Z" />
                            <Rectangle Canvas.Left="4.5" Canvas.Top="1" Width="7" Height="5"
                                       Stroke="{StaticResource Ink}" StrokeThickness="1.4" />
                            <Ellipse Canvas.Left="5" Canvas.Top="15.5" Width="3" Height="3" Fill="{StaticResource Ink}" />
                            <Ellipse Canvas.Left="10" Canvas.Top="15.5" Width="3" Height="3" Fill="{StaticResource Ink}" />
                            <Ellipse Canvas.Left="15" Canvas.Top="15.5" Width="3" Height="3" Fill="{StaticResource Ink}" />
                        </Canvas>
                    </Button>

                    <Border Width="1" Margin="4,3" Background="{StaticResource RuleDark}" />
                    <Border Width="1" Margin="0,3,4,3" Background="{StaticResource RuleLight}" />

                    <Button x:Name="CloseButton" Style="{StaticResource IconButton}" ToolTip="Close (Esc)">
                        <!-- Fixed 20×20 box so the X centres like the other toolbar icons. -->
                        <Canvas Width="20" Height="20">
                            <Path Stroke="{StaticResource Ink}" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M5.5,5.5 L14.5,14.5 M14.5,5.5 L5.5,14.5" />
                        </Canvas>
                    </Button>
                </StackPanel>
            </Border>
        </Canvas>

        <!-- OCR mode status/help bar (top-centre). -->
        <Border x:Name="OcrHint"
                Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,24,0,0" Padding="12,6"
                Background="{StaticResource PanelTint}" CornerRadius="6"
                IsHitTestVisible="False">
            <TextBlock x:Name="OcrHintText" Foreground="White" FontSize="13" Text="OCR" />
        </Border>

    </Grid>
</Window>
